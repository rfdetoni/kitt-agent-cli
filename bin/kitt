#!/bin/sh
set -eu

# Resolve target script path even if executed via symlink
target="$0"
while [ -L "$target" ]; do
    target_dir=$(cd -P "$(dirname "$target")" && pwd)
    target=$(readlink "$target")
    case "$target" in
        /*) ;;
        *) target="$target_dir/$target" ;;
    esac
done
script_dir=$(cd -P "$(dirname "$target")" && pwd)
project_dir=$(cd -P "$script_dir/.." && pwd)
python="$project_dir/.venv/bin/python"

if [ ! -x "$python" ]; then
    python=${PYTHON:-python3}
fi

exec "$python" -m kitt.cli.main "$@"
